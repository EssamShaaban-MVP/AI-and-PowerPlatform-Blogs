---
import Base from '../layouts/Base.astro';
import { site, certifications } from '../data/site';
import MvpBanner from '../components/MvpBanner.astro';
import { breadcrumbs, personRef } from '../lib/seo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const badge = (name: string) => `${base}/badges/${name}.svg`;
const verify = site.links.learnTranscript;
const fullName = (title: string) => `Microsoft Certified: ${title}`;

// Everything below is derived from the single `certifications` data source.
const expert = certifications.filter(c => c.level === 'Expert');
const associate = certifications.filter(c => c.level === 'Associate');
const other = certifications.filter(c => c.level !== 'Expert' && c.level !== 'Associate');
const activeCount = certifications.filter(c => c.status === 'active').length;
const years = certifications.map(c => new Date(c.earned).getFullYear());
const yearRange = `${Math.min(...years)}—${Math.max(...years)}`;
const typeLabel: Record<string, string> = { 'role-based': 'Role-based', fundamentals: 'Fundamentals', business: 'AI business' };

const groups = [
  { id: 'associate', title: 'Associate', note: 'Role-based certifications', items: associate, cols: 3 },
  { id: 'other', title: 'Other Microsoft certifications', note: 'AI business and fundamentals credentials', items: other, cols: 4 },
];
---
<Base
  title="Microsoft Certifications | Essam Shaaban"
  description={`${certifications.length} Microsoft certifications, including the Agentic AI Business Solutions Architect Expert, plus Microsoft MVP recognition — verified on Microsoft Learn.`}
  image="/og/certifications.jpg"
  imageAlt="Microsoft Certifications — Essam Shaaban"
  jsonLd={[
    breadcrumbs([['Home', '/'], ['Certifications', '/certifications/']]),
    { ...personRef, hasCredential: certifications.filter(c => c.status === 'active').map(c => ({
      '@type': 'EducationalOccupationalCredential',
      name: fullName(c.title),
      credentialCategory: 'Professional certification',
      educationalLevel: c.level,
      recognizedBy: { '@type': 'Organization', name: 'Microsoft', url: 'https://www.microsoft.com' },
      ...(c.verifyUrl ? { url: c.verifyUrl } : {}),
    })) },
  ]}
>
<section class="page-heading container cg-heading">
  <span class="eyebrow">MICROSOFT CREDENTIALS / {yearRange}</span>
  <h1>Credentials that reflect<br/><span class="gradient-text">constant curiosity.</span></h1>
  <p>{certifications.length} Microsoft certifications earned, {activeCount} currently active. Each one can be verified on my public Microsoft Learn transcript.</p>
  <ul class="cg-stats" aria-label="Certification summary">
    <li><strong>{expert.length}</strong> Expert</li>
    <li><strong>{associate.length}</strong> Associate</li>
    <li><strong>{other.length}</strong> Other</li>
  </ul>
  {verify && <a class="button button-primary cg-verify" href={verify} target="_blank" rel="noopener">Verify My Credentials <span aria-hidden="true">↗</span></a>}
</section>

<section class="container credentials-page">
  <MvpBanner headingLevel={2} />

  {expert.length > 0 && <div class="cg-group" id="expert">
    <div class="cg-group-head"><h2>Expert</h2><span>Highest certification level</span></div>
    {expert.map(c => (
      <article class="cert-featured">
        <div class="cert-featured-badge badge-plate"><img src={badge(c.badge)} alt={`${fullName(c.title)} badge`} width="200" height="200" /></div>
        <div class="cert-featured-body">
          <span class="cert-featured-label">Expert-level certification</span>
          <div class="cert-code">{c.code} · {typeLabel[c.type].toUpperCase()}</div>
          <h3><span class="cg-prefix">Microsoft Certified:</span> {c.title}</h3>
          <p>Expert is the highest level of Microsoft role-based certification.</p>
          <div class="cert-dates"><span>Earned <strong>{c.earned}</strong></span>{c.expires && <span>{c.status === 'expired' ? 'Expired' : 'Valid until'} <strong>{c.expires}</strong></span>}</div>
          {c.verifyUrl && <a class="text-link" href={c.verifyUrl} target="_blank" rel="noopener">Verify this credential <span aria-hidden="true">↗</span></a>}
        </div>
      </article>
    ))}
  </div>}

  {groups.map(g => g.items.length > 0 && (
    <div class="cg-group" id={g.id}>
      <div class="cg-group-head"><h2>{g.title}</h2><span>{g.note}</span></div>
      <div class:list={['cg-grid', `cg-cols-${g.cols}`]}>
        {g.items.map(c => (
          <article class:list={['cg-card', `cg-${c.type}`, c.status === 'expired' && 'is-expired']}>
            <div class="cg-card-top">
              <span class="badge-plate cg-badge"><img src={badge(c.badge)} alt={`${fullName(c.title)} badge`} width="96" height="96" loading="lazy" decoding="async" /></span>
              <span class:list={['cg-type', c.status === 'expired' && 'cg-expired']}>{c.status === 'expired' ? 'Expired' : typeLabel[c.type]}</span>
            </div>
            <p class="cg-prefix">Microsoft Certified:</p>
            <h3>{c.title}</h3>
            <span class="cg-code">{c.code}</span>
            <dl class="cg-dates">
              <div><dt>Earned</dt><dd>{c.earned}</dd></div>
              {c.expires && <div><dt>{c.status === 'expired' ? 'Expired' : 'Valid until'}</dt><dd>{c.expires}</dd></div>}
            </dl>
            {c.verifyUrl && <a class="cg-card-verify" href={c.verifyUrl} target="_blank" rel="noopener">Verify <span aria-hidden="true">↗</span></a>}
          </article>
        ))}
      </div>
    </div>
  ))}

  {verify && <div class="cert-disclaimer">Titles, dates and status match my <a href={verify} target="_blank" rel="noopener">Microsoft Learn transcript</a>. Expiry dates appear only where Microsoft Learn lists one. Badge artwork © Microsoft.</div>}
</section>
</Base>
