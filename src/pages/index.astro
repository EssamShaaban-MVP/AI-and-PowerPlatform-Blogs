---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, projects, certifications } from '../data/site';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (s:string) => base + s;
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base>
<section class="hero container">
  <div class="hero-decoration hero-decoration-one"></div><div class="hero-decoration hero-decoration-two"></div>
  <div class="hero-left">
    <div class="availability"><span class="pulse"></span> MICROSOFT MVP · POWER PLATFORM</div>
    <p class="hero-overline">HELLO, I'M ESSAM SHAABAN <span class="overline-rule"></span></p>
    <h1>Building the<br/><span class="gradient-text">next generation</span><br/>of enterprise AI.</h1>
    <p class="hero-intro">{site.intro}</p>
    <div class="hero-actions"><a class="button button-primary" href="#work">Explore my work <span>↗</span></a><a class="button button-secondary" href={url('/blog/')}>Read the blog <span>→</span></a></div>
    <div class="hero-bottom"><span><span class="mini-icon">⌖</span> {site.location}</span><span><span class="mini-icon">✧</span> AI · Cloud · Low-code</span></div>
  </div>
  <div class="hero-right"><div class="orbit orbit-a" aria-hidden="true"></div><div class="orbit orbit-b" aria-hidden="true"></div><div class="orbit orbit-c" aria-hidden="true"></div><div class="hero-core has-photo"><img src={url('/essam-shaaban.webp')} alt="Portrait of Essam Shaaban" width="640" height="640" fetchpriority="high" /></div><div class="floating-panel panel-one" aria-hidden="true"><span class="panel-symbol">✦</span><div><small>RECOGNITION</small><strong>Microsoft MVP</strong></div><span class="panel-arrow">↗</span></div><div class="floating-panel panel-two" aria-hidden="true"><span class="panel-symbol purple">◈</span><div><small>FOCUS</small><strong>Agentic AI Architectures</strong></div></div><div class="dot-matrix" aria-hidden="true"></div></div>
</section>
<section class="metrics-strip"><div class="container metrics-grid"><div><strong>08</strong><span>Microsoft certifications</span></div><div><strong>MVP</strong><span>Microsoft recognition</span></div><div><strong>AI +</strong><span>Power Platform expertise</span></div><div><strong>∞</strong><span>Curiosity for what's next</span></div></div></section>
<section class="section container" id="about"><SectionHeading eyebrow="01 / ABOUT ME" title="Engineering with purpose." subtitle="From business problems to scalable digital experiences."/><div class="about-grid"><div class="about-quote"><span class="quote-symbol">“</span><p>Technology should make complex work feel <em>simple.</em></p><div class="quote-foot">— My engineering philosophy</div></div><div class="about-copy"><p>I'm a Senior Software Engineer and Microsoft MVP specializing in the Microsoft Power Platform and the evolving agentic AI ecosystem.</p><p>My work focuses on secure architecture, thoughtful user experiences, data integration, and automation that supports real operational outcomes.</p><p>Outside delivery work, I share hands-on technical writing, architecture patterns, and lessons learned with the Microsoft community.</p><a href={url('/certifications/')} class="text-link">Explore certifications <span>↗</span></a></div></div></section>
<section class="section section-alt" id="expertise"><div class="container"><SectionHeading eyebrow="02 / WHAT I DO" title="Built for the real world." subtitle="A practical blend of modern AI and enterprise engineering."/><div class="expertise-grid"><div class="expertise-card"><div class="expertise-icon">✧</div><span class="tiny-label">01 / INTELLIGENCE</span><h3>Agentic AI & Copilots</h3><p>Grounded agents, MCP tool patterns, orchestration, model evaluation, and responsible AI adoption.</p><div class="tag-row"><span>Microsoft Foundry</span><span>Copilot Studio</span><span>Databricks</span></div></div><div class="expertise-card"><div class="expertise-icon">◈</div><span class="tiny-label">02 / ENGINEERING</span><h3>Power Platform</h3><p>Production-grade Power Apps, automation, data models, governance, and connected business experiences.</p><div class="tag-row"><span>Power Apps</span><span>Dataverse</span><span>Power Automate</span></div></div><div class="expertise-card"><div class="expertise-icon">◎</div><span class="tiny-label">03 / ARCHITECTURE</span><h3>Cloud & Integration</h3><p>Secure integration strategies, Azure-native services, enterprise data access, and maintainable solutions.</p><div class="tag-row"><span>Azure</span><span>Logic Apps</span><span>APIs</span></div></div></div></div></section>
<section class="section container" id="work"><SectionHeading eyebrow="03 / SELECTED WORK" title="Ideas into impact." subtitle="Representative architecture and solution themes. Internal details are intentionally omitted." rightText="SELECTED PROJECTS / 2024—2026"/><div class="projects-grid">{projects.map((p,i)=><article class="project-card"><div class="project-top"><span>{p.number} / {p.type}</span><span class="project-arrow">↗</span></div><div class="project-art" class:list={['art-'+i]}><span>{p.icon}</span><div class="art-line"></div></div><h3>{p.title}</h3><p>{p.description}</p><div class="tag-row">{p.tags.map(tag=><span>{tag}</span>)}</div></article>)}</div></section>
<section class="section section-alt" id="credentials"><div class="container"><SectionHeading eyebrow="04 / CREDENTIALS" title="Committed to continuous growth." subtitle="Microsoft certifications across AI, agentic AI and Power Platform."/><div class="recognition-banner"><div class="recognition-emblem">✦</div><div><span class="tiny-label">COMMUNITY RECOGNITION</span><h3>Microsoft Most Valuable Professional</h3><p>Power Platform · Recognized for community contributions and technical knowledge sharing</p></div><div class="banner-end">MVP <span>↗</span></div></div><div class="credential-grid">{certifications.slice(0,4).map(c=><div class="credential-mini"><div class:list={['credential-badge',c.tone]}>✧</div><div><span>{c.level} {c.code && '· '+c.code}</span><strong>{c.title}</strong></div></div>)}</div><a href={url('/certifications/')} class="button button-secondary more-button">View all 8 certifications <span>↗</span></a></div></section>
<section class="section container" id="writing"><SectionHeading eyebrow="05 / TECHNICAL WRITING" title="Notes from the field." subtitle="Patterns, implementation guides, and honest engineering tradeoffs."/><div class="blog-grid">{posts.map((post,i)=><a class="blog-card" href={url('/blog/'+post.id+'/')}><div class:list={['blog-art','blog-art-'+i]}><span>{i===0?'✳':i===1?'◈':'⌘'}</span><small>{post.data.category}</small></div><div class="blog-card-body"><div class="post-meta"><span>{post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span><span>{post.data.readingMinutes ?? 5} MIN READ</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="text-link">Read article ↗</span></div></a>)}</div><div class="center-action"><a class="button button-secondary" href={url('/blog/')}>Browse all articles <span>→</span></a></div></section>
<section class="contact-section" id="contact"><div class="container contact-inner"><span class="eyebrow">06 / LET'S CONNECT</span><h2>Let's build something<br/><span class="gradient-text">meaningful.</span></h2><p>Interested in AI architecture, Power Platform, technical collaboration or community speaking? I'd be glad to connect.</p><div class="contact-actions"><a class="button button-primary" href={url('/blog/')}>Explore my ideas ↗</a><span>Connect through your preferred professional network</span></div></div></section>
</Base>
