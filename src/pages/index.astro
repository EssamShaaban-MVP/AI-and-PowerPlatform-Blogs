---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site, projects, certifications } from '../data/site';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (s:string) => base + s;
const contactLinks = ([['Connect on LinkedIn', site.links.linkedin], ['Email me', site.links.email && 'mailto:' + site.links.email], ['MVP profile', site.links.mvp], ['GitHub', site.links.github]] as [string,string][]).filter(([,h]) => h);
const badge = (n:string) => url('/badges/'+n+'.svg');
const featuredCert = certifications.find(c => c.featured);
const homeCerts = certifications.filter(c => !c.featured && c.status === 'active').slice(0,4);
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base>
<section class="hero container">
  <div class="hero-decoration hero-decoration-one"></div><div class="hero-decoration hero-decoration-two"></div>
  <div class="hero-left">
    <p class="hero-overline">HELLO, I'M ESSAM SHAABAN <span class="overline-rule"></span></p>
    <h1>Building the<br/><span class="gradient-text">next generation</span><br/>of enterprise AI.</h1>
    <p class="hero-intro">{site.intro}</p>
    <ul class="hero-proof"><li>Microsoft MVP</li><li>8 Microsoft certifications</li><li>Senior Software Engineer</li><li>Power Platform &amp; Agentic AI</li></ul>
    <div class="hero-actions"><a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">→</span></a><a class="button button-secondary" href={url('/blog/')}>Read the blog <span aria-hidden="true">→</span></a></div>
    <div class="hero-bottom"><span><span class="mini-icon">⌖</span> {site.location}</span></div>
  </div>
  <div class="hero-right"><div class="hero-portrait"><img src={url('/essam-shaaban-cutout.webp')} alt="Portrait of Essam Shaaban" width="1040" height="891" fetchpriority="high" /></div></div>
</section>
<section class="section container" id="about"><SectionHeading eyebrow="01 / ABOUT ME" title="Engineering with purpose." subtitle="From business problems to scalable digital experiences."/><div class="about-grid"><div class="about-quote"><span class="quote-symbol">“</span><p>Technology should make complex work feel <em>simple.</em></p><div class="quote-foot">— My engineering philosophy</div></div><div class="about-copy"><p>I'm a Senior Software Engineer and Microsoft MVP specializing in the Microsoft Power Platform and the evolving agentic AI ecosystem.</p><p>My work focuses on secure architecture, thoughtful user experiences, data integration, and automation that supports real operational outcomes.</p><p>Outside delivery work, I share hands-on technical writing, architecture patterns, and lessons learned with the Microsoft community.</p><a href={url('/certifications/')} class="text-link">Explore certifications <span aria-hidden="true">→</span></a></div></div></section>
<section class="section section-alt" id="expertise"><div class="container"><SectionHeading eyebrow="02 / WHAT I DO" title="Built for the real world." subtitle="A practical blend of modern AI and enterprise engineering."/><div class="expertise-grid"><div class="expertise-card"><div class="expertise-icon">✧</div><span class="tiny-label">01 / INTELLIGENCE</span><h3>Agentic AI & Copilots</h3><p>Grounded agents, MCP tool patterns, orchestration, model evaluation, and responsible AI adoption.</p><div class="tag-row"><span>Microsoft Foundry</span><span>Copilot Studio</span><span>Databricks</span></div></div><div class="expertise-card"><div class="expertise-icon">◈</div><span class="tiny-label">02 / ENGINEERING</span><h3>Power Platform</h3><p>Production-grade Power Apps, automation, data models, governance, and connected business experiences.</p><div class="tag-row"><span>Power Apps</span><span>Dataverse</span><span>Power Automate</span></div></div><div class="expertise-card"><div class="expertise-icon">◎</div><span class="tiny-label">03 / ARCHITECTURE</span><h3>Cloud & Integration</h3><p>Secure integration strategies, Azure-native services, enterprise data access, and maintainable solutions.</p><div class="tag-row"><span>Azure</span><span>Logic Apps</span><span>APIs</span></div></div></div></div></section>
<section class="section container" id="work"><SectionHeading eyebrow="03 / SELECTED WORK" title="Ideas into impact." subtitle="Representative architecture and solution themes. Internal details are intentionally omitted." rightText="SELECTED PROJECTS / 2024—2026"/><div class="projects-grid">{projects.map((p,i)=><article class="project-card"><div class="project-top"><span>{p.number} / {p.type}</span></div><div class="project-art" class:list={['art-'+i]}><span>{p.icon}</span><div class="art-line"></div></div><h3>{p.title}</h3><p>{p.description}</p><div class="tag-row">{p.tags.map(tag=><span>{tag}</span>)}</div></article>)}</div></section>
<section class="section section-alt" id="credentials"><div class="container"><SectionHeading eyebrow="04 / CREDENTIALS" title="Committed to continuous growth." subtitle="Microsoft certifications across AI, agentic AI and Power Platform — verified on Microsoft Learn."/>{featuredCert && <a class="cert-featured cert-featured-home" href={url('/certifications/')}><div class="cert-featured-badge"><img src={badge(featuredCert.badge)} alt={`Microsoft Certified ${featuredCert.level} badge`} width="200" height="200" loading="lazy" /></div><div class="cert-featured-body"><span class="cert-featured-label">Expert-level certification</span><div class="cert-code">{featuredCert.code} · MICROSOFT CERTIFIED</div><h3>{featuredCert.title}</h3><div class="cert-dates"><span>Earned <strong>{featuredCert.earned}</strong></span>{featuredCert.expires && <span>Valid until <strong>{featuredCert.expires}</strong></span>}</div></div></a>}<div class="credential-grid">{homeCerts.map(c=><div class="credential-mini"><img class="credential-badge-img" src={badge(c.badge)} alt="" width="56" height="56" loading="lazy" /><div><span>{c.level} · {c.code}</span><strong>{c.title}</strong></div></div>)}</div><a class="recognition-banner recognition-link" href={site.links.mvp} target="_blank" rel="noopener"><div class="recognition-emblem">✦</div><div><span class="tiny-label">COMMUNITY RECOGNITION</span><h3>Microsoft Most Valuable Professional</h3><p>Power Platform · Recognized for community contributions and technical knowledge sharing</p></div></a><div class="cert-actions"><a href={url('/certifications/')} class="button button-secondary">View all {certifications.length} certifications <span aria-hidden="true">→</span></a>{site.links.learnTranscript && <a class="button button-secondary" href={site.links.learnTranscript} target="_blank" rel="noopener">Verify on Microsoft Learn <span aria-hidden="true">↗</span></a>}</div></div></section>
<section class="section container" id="writing"><SectionHeading eyebrow="05 / TECHNICAL WRITING" title="Notes from the field." subtitle="Patterns, implementation guides, and honest engineering tradeoffs."/><div class="blog-grid">{posts.map((post,i)=><a class="blog-card" href={url('/blog/'+post.id+'/')}><div class:list={['blog-art','blog-art-'+i]}><span>{i===0?'✳':i===1?'◈':'⌘'}</span><small>{post.data.category}</small></div><div class="blog-card-body"><div class="post-meta"><span>{post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'})}</span><span>{post.data.readingMinutes ?? 5} MIN READ</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="text-link">Read article <span aria-hidden="true">→</span></span></div></a>)}</div><div class="center-action"><a class="button button-secondary" href={url('/blog/')}>Browse all articles <span aria-hidden="true">→</span></a></div></section>
<section class="contact-section" id="contact"><div class="container contact-inner"><span class="eyebrow">06 / LET'S CONNECT</span><h2>Let's build something<br/><span class="gradient-text">meaningful.</span></h2><p>Interested in AI architecture, Power Platform, technical collaboration or community speaking? I'd be glad to connect.</p><div class="contact-actions">{contactLinks.length ? contactLinks.map(([label,href],i)=><a class:list={['button', i===0?'button-primary':'button-secondary']} href={href} target={href.startsWith('http')?'_blank':undefined} rel={href.startsWith('http')?'noopener':undefined}>{label} <span aria-hidden="true">↗</span></a>) : <a class="button button-primary" href={url('/blog/')}>Read my articles <span aria-hidden="true">→</span></a>}</div></div></section>
</Base>
