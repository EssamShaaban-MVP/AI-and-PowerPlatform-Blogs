---
import Base from '../layouts/Base.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ExpertiseSection from '../components/ExpertiseSection.astro';
import ProcessTimeline from '../components/ProcessTimeline.astro';
import CredentialStats from '../components/CredentialStats.astro';
import AboutRobot from '../components/AboutRobot.astro';
import Icon from '../components/Icon.astro';
import { person, homeUrl, websiteId } from '../lib/seo';
const blogIcon: Record<string,string> = { 'Agentic AI':'sparkles', 'Architecture':'layers', 'Power Platform':'workflow' };
import { site, projects, certifications, mvp } from '../data/site';
import MvpBanner from '../components/MvpBanner.astro';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (s:string) => base + s;
const contactLinks = ([['Connect on LinkedIn', site.links.linkedin], ['Email me', site.links.email && 'mailto:' + site.links.email], ['MVP profile', site.links.mvp], ['GitHub', site.links.github]] as [string,string][]).filter(([,h]) => h);
const badge = (n:string) => url('/badges/'+n+'.svg');
const featuredCert = certifications.find(c => c.featured);
const homeCerts = certifications.filter(c => !c.featured && c.status === 'active').slice(0,4);
const posts = (await getCollection('blog', ({data}) => !data.draft)).sort((a,b)=>b.data.date.valueOf()-a.data.date.valueOf()).slice(0,3);
---
<Base
  title="Essam Shaaban | Microsoft MVP · Power Platform & Agentic AI"
  description="Microsoft MVP and Senior Software Engineer building secure, scalable business applications and enterprise agentic AI with Power Platform and Microsoft Foundry."
  image="/og/home.jpg"
  imageAlt="Essam Shaaban — Architecting Intelligent Enterprise Solutions"
  jsonLd={[{ '@type': 'ProfilePage', '@id': homeUrl + '#profile', url: homeUrl, name: 'Essam Shaaban — Microsoft MVP', isPartOf: { '@id': websiteId }, mainEntity: person }]}
>
<section class="hx" aria-labelledby="hx-title">
  <div class="container hx-inner">
    <div class="hx-copy">
      <p class="hx-eyebrow">Essam Shaaban</p>
      <h1 id="hx-title">Architecting <span class="hx-accent">Intelligent</span> <span class="hx-keep">Enterprise Solutions</span></h1>
      <p class="hx-intro">Microsoft MVP and Senior Software Engineer focused on building secure, scalable business applications and exploring enterprise Agentic AI architectures across Microsoft Power Platform, Microsoft Foundry, and connected data platforms.</p>
      <a class="hx-mvp" href={site.links.mvp} target="_blank" rel="noopener">
        <img src={url(mvp.badgeSmall)} alt="" width="56" height="56" />
        <span><strong>Microsoft Most Valuable Professional</strong><small>{mvp.category} · {mvp.currentAward}</small></span>
        <span class="hx-mvp-arrow" aria-hidden="true">↗</span>
      </a>
      <div class="hx-actions">
        <a class="button button-primary" href="#work">Explore My Work <span aria-hidden="true">→</span></a>
        <a class="button button-secondary" href={url('/blog/')}>Read Technical Blog <span aria-hidden="true">→</span></a>
      </div>
      <p class="hx-meta">Senior Software Engineer <span aria-hidden="true">·</span> {site.location}</p>
    </div>
    <div class="hx-visual">
      <img class="hx-portrait" src={url('/essam-shaaban-cutout.webp')} srcset={`${url('/essam-shaaban-cutout-600.webp')} 600w, ${url('/essam-shaaban-cutout.webp')} 1040w`} sizes="(max-width: 900px) min(440px, 88vw), 560px" alt="Essam Shaaban, Microsoft MVP and Senior Software Engineer" width="1040" height="891" fetchpriority="high" decoding="async" />
    </div>
  </div>
</section>
<section class="section container" id="about"><SectionHeading eyebrow="01 / ABOUT ME" title="Engineering with purpose." subtitle="From business problems to scalable digital experiences."/><div class="about-grid"><div class="about-quote"><span class="quote-symbol">“</span><p>Technology should make complex work feel <em>simple.</em></p><div class="quote-foot">— My engineering philosophy</div></div><div class="about-copy"><p>I'm a Senior Software Engineer and Microsoft MVP in Business Applications, specializing in the Microsoft Power Platform and the evolving agentic AI ecosystem.</p><p>My work focuses on secure architecture, thoughtful user experiences, data integration, and automation that supports real operational outcomes.</p><p>Outside delivery work, I share hands-on technical writing, architecture patterns, and lessons learned with the Microsoft community.</p><a href={url('/certifications/')} class="text-link">Explore certifications <span aria-hidden="true">→</span></a></div></div><AboutRobot /></section>
<ExpertiseSection />
<ProcessTimeline />
<section class="section container" id="work"><SectionHeading eyebrow="04 / SELECTED WORK" title="Ideas into impact." subtitle="Representative architecture and solution themes. Internal details are intentionally omitted." rightText="SELECTED PROJECTS / 2024—2026"/><div class="projects-grid">{projects.map((p,i)=><article class="project-card"><div class="project-top"><span>{p.number} / {p.type}</span></div><div class="project-art" class:list={['art-'+i]}><Icon name={p.icon} /><div class="art-line"></div></div><h3>{p.title}</h3><p>{p.description}</p><div class="tag-row">{p.tags.map(tag=><span>{tag}</span>)}</div></article>)}</div></section>
<section class="section section-alt" id="credentials"><div class="container"><SectionHeading eyebrow="05 / CREDENTIALS" title="Committed to continuous growth." subtitle="Microsoft certifications across AI, agentic AI and Power Platform — verified on Microsoft Learn."/><CredentialStats /><MvpBanner />{featuredCert && <a class="cert-featured cert-featured-home" href={url('/certifications/')}><div class="cert-featured-badge badge-plate"><img src={badge(featuredCert.badge)} alt={`Microsoft Certified ${featuredCert.level} badge`} width="200" height="200" loading="lazy" /></div><div class="cert-featured-body"><span class="cert-featured-label">Expert-level certification</span><div class="cert-code">{featuredCert.code} · MICROSOFT CERTIFIED</div><h3>{featuredCert.title}</h3><div class="cert-dates"><span>Earned <strong>{featuredCert.earned}</strong></span>{featuredCert.expires && <span>Valid until <strong>{featuredCert.expires}</strong></span>}</div></div></a>}<div class="credential-grid">{homeCerts.map(c=><div class="credential-mini"><span class="badge-plate badge-plate-sm"><img class="credential-badge-img" src={badge(c.badge)} alt="" width="56" height="56" loading="lazy" /></span><div><span>{c.level} · {c.code}</span><strong>{c.title}</strong></div></div>)}</div><div class="cert-actions"><a href={url('/certifications/')} class="button button-secondary">View all {certifications.length} certifications <span aria-hidden="true">→</span></a>{site.links.learnTranscript && <a class="button button-secondary" href={site.links.learnTranscript} target="_blank" rel="noopener">Verify on Microsoft Learn <span aria-hidden="true">↗</span></a>}</div></div></section>
<section class="section container" id="writing"><SectionHeading eyebrow="06 / TECHNICAL WRITING" title="Notes from the field." subtitle="Patterns, implementation guides, and honest engineering tradeoffs."/><div class="blog-grid">{posts.map((post,i)=><a class="blog-card" href={url('/blog/'+post.id+'/')}><div class:list={['blog-art','blog-art-'+i]}><Icon name={blogIcon[post.data.category] ?? 'layers'} /><small>{post.data.category}</small></div><div class="blog-card-body"><div class="post-meta"><time datetime={post.data.date.toISOString().slice(0,10)}>{post.data.date.toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><span>{post.data.readingMinutes ?? 5} MIN READ</span></div><h3>{post.data.title}</h3><p>{post.data.description}</p><span class="text-link">Read article <span aria-hidden="true">→</span></span></div></a>)}</div><div class="center-action"><a class="button button-secondary" href={url('/blog/')}>Browse all articles <span aria-hidden="true">→</span></a></div></section>
<section class="contact-section" id="contact"><div class="container contact-inner"><span class="eyebrow">07 / LET'S CONNECT</span><h2>Let's build something<br/><span class="gradient-text">meaningful.</span></h2><p>Interested in AI architecture, Power Platform, technical collaboration or community speaking? I'd be glad to connect.</p><div class="contact-actions">{contactLinks.length ? contactLinks.map(([label,href],i)=><a class:list={['button', i===0?'button-primary':'button-secondary']} href={href} target={href.startsWith('http')?'_blank':undefined} rel={href.startsWith('http')?'noopener':undefined}>{label} <span aria-hidden="true">↗</span></a>) : <a class="button button-primary" href={url('/blog/')}>Read my articles <span aria-hidden="true">→</span></a>}</div></div></section>
</Base>
