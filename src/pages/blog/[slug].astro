---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths(){ const posts=await getCollection('blog',({data})=>!data.draft); return posts.map(post=>({params:{slug:post.id},props:{post}})); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${post.data.title} | Essam Shaaban`} description={post.data.description}><article class="article container"><a href={`${base}/blog/`} class="back-link">← All articles</a><div class="article-head"><div class="post-meta"><span>{post.data.category}</span><span>{post.data.date.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric'})}</span><span>{post.data.readingMinutes??5} MIN READ</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tag-row">{post.data.tags.map(tag=><span>{tag}</span>)}</div></div><div class="article-layout"><div class="article-prose"><Content /><div class="article-outro"><span>END OF ARTICLE</span><a href={`${base}/blog/`}>← Back to the blog</a></div></div><aside class="toc"><span class="tiny-label">ON THIS PAGE</span><nav aria-label="Table of contents">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside></div></article></Base>
