---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import { getCollection, render } from 'astro:content';
import { abs, breadcrumbs, personRef } from '../../lib/seo';
export async function getStaticPaths(){ const posts=await getCollection('blog',({data})=>!data.draft); return posts.map(post=>({params:{slug:post.id},props:{post}})); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = abs(`/blog/${post.id}/`);
// Per-article share image (generated by `npm run og`); fall back to the site image if it doesn't exist yet.
const ogPath = `/og/blog/${post.id}.jpg`;
const image = fs.existsSync(path.join(process.cwd(), 'public', ogPath)) ? ogPath : '/og/blog.jpg';
const published = post.data.date;
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    image: abs(image),
    datePublished: published.toISOString(),
    dateModified: published.toISOString(),
    author: personRef,
    publisher: personRef,
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    wordCount,
    inLanguage: 'en-US',
    isPartOf: { '@type': 'Blog', '@id': abs('/blog/') + '#blog' },
  },
  breadcrumbs([['Home', '/'], ['Blog', '/blog/'], [post.data.title, `/blog/${post.id}/`]]),
];
---
<Base title={`${post.data.title} | Essam Shaaban`} description={post.data.description} image={image} imageAlt={`${post.data.title} — article by Essam Shaaban`} type="article" published={published} tags={post.data.tags} section={post.data.category} jsonLd={jsonLd}><article class="article container"><a href={`${base}/blog/`} class="back-link">← All articles</a><div class="article-head"><div class="post-meta"><span>{post.data.category}</span><time datetime={published.toISOString().slice(0,10)}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><span>{post.data.readingMinutes??5} MIN READ</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tag-row">{post.data.tags.map(tag=><span>{tag}</span>)}</div><ShareLinks url={url} title={post.data.title} /></div><div class="article-layout"><div class="article-prose"><Content /><ShareLinks url={url} title={post.data.title} label="Found this useful? Share it" /><div class="article-outro"><span>END OF ARTICLE</span><a href={`${base}/blog/`}>← Back to the blog</a></div></div><aside class="toc"><span class="tiny-label">ON THIS PAGE</span><nav aria-label="Table of contents">{headings.filter(h=>h.depth===2).map(h=><a href={`#${h.slug}`}>{h.text}</a>)}</nav></aside></div></article></Base>
