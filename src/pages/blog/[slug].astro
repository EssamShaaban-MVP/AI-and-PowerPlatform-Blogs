---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import BlogCard from '../../components/BlogCard.astro';
import { coverSrc } from '../../data/blog';
import { getCollection, render } from 'astro:content';
import { abs, breadcrumbs, personRef } from '../../lib/seo';
export async function getStaticPaths(){ const posts=await getCollection('blog',({data})=>!data.draft); return posts.map(post=>({params:{slug:post.id},props:{post}})); }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const all = (await getCollection('blog', ({ data }) => !data.draft)).filter(p => p.id !== post.id).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const related = [...all.filter(p => p.data.category === post.data.category), ...all.filter(p => p.data.category !== post.data.category)].slice(0, 3);
// Article images live in /public/blog-images and are written as root-relative paths in the Markdown;
// add the site base so they also resolve under a GitHub Pages project path (e.g. /repo-name/).
const bodyHtml = post.rendered?.html?.replace(/(src=")\/blog-images\//g, `$1${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog-images/`);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = abs(`/blog/${post.id}/`);
// Per-article share image (generated by `npm run og`); fall back to the site image if it doesn't exist yet.
const ogPath = `/og/blog/${post.id}.jpg`;
const image = fs.existsSync(path.join(process.cwd(), 'public', ogPath)) ? ogPath : '/og/blog.jpg';
const published = post.data.date;
const wordCount = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const jsonLd = [
  {
    '@type': 'BlogPosting',
    '@id': `${url}#article`,
    headline: post.data.title,
    description: post.data.description,
    url,
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    image: abs(image),
    datePublished: published.toISOString(),
    dateModified: published.toISOString(),
    author: personRef,
    publisher: personRef,
    articleSection: post.data.category,
    keywords: post.data.tags.join(', '),
    wordCount,
    inLanguage: 'en-US',
    isPartOf: { '@type': 'Blog', '@id': abs('/blog/') + '#blog' },
  },
  breadcrumbs([['Home', '/'], ['Blog', '/blog/'], [post.data.title, `/blog/${post.id}/`]]),
];
---
<Base title={`${post.data.title} | Essam Shaaban`} description={post.data.description} image={image} imageAlt={`${post.data.title} — article by Essam Shaaban`} type="article" published={published} tags={post.data.tags} section={post.data.category} jsonLd={jsonLd} contact={false}><article class="article container"><a href={`${base}/blog/`} class="back-link">← All articles</a><div class="article-head"><div class="post-meta"><span>{post.data.category}</span><time datetime={published.toISOString().slice(0,10)}>{published.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><span>{post.data.readingMinutes??5} MIN READ</span></div><h1>{post.data.title}</h1><p>{post.data.description}</p><div class="tag-row">{post.data.tags.map(tag=><span>{tag}</span>)}</div><ShareLinks url={url} title={post.data.title} /></div>{post.data.cover && (post.data.coverLinks?.length
  ? <figure class="article-cover article-roadmap"><div class="roadmap"><img src={coverSrc(post)} alt={`${post.data.title}: clickable roadmap`} width="1920" height="1152" fetchpriority="high" decoding="async" />{post.data.coverLinks.map(l => <a href={l.href} target="_blank" rel="noopener" title={l.label} aria-label={`${l.label} (opens Microsoft page in a new tab)`} style={`left:${l.left}%;top:${l.top}%;width:${l.width}%;height:${l.height}%`}></a>)}</div><figcaption>Click any card to open its official Microsoft page.</figcaption></figure>
  : <figure class="article-cover"><img src={coverSrc(post)} alt={`Cover image for ${post.data.title}`} width="1200" height="630" fetchpriority="high" decoding="async" /></figure>)}<div class="article-layout"><div class="article-prose">{bodyHtml ? <Fragment set:html={bodyHtml} /> : <Content />}<ShareLinks url={url} title={post.data.title} label="Found this useful? Share it" /><div class="article-outro"><span>END OF ARTICLE</span><a href={`${base}/blog/`}>← Back to the blog</a></div></div><aside class="toc"><span class="tiny-label">ON THIS PAGE</span><nav aria-label="Table of contents">{headings.filter(h=>h.depth<=3).map(h=><a href={`#${h.slug}`} class={h.depth===3 ? 'toc-sub' : undefined}>{h.text}</a>)}</nav></aside></div></article>
<section class="container related" aria-labelledby="related-title"><div class="related-head"><h2 id="related-title">Keep reading</h2><a class="text-link" href={`${base}/blog/`}>All articles <span aria-hidden="true">→</span></a></div><div class="bgrid">{related.map(r => <BlogCard post={r} tags={false} />)}</div></section></Base>
