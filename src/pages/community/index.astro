---
import Base from '../../layouts/Base.astro';
import MvpBanner from '../../components/MvpBanner.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site, mvp } from '../../data/site';
import { abs, breadcrumbs } from '../../lib/seo';
import { getCollection } from 'astro:content';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (s: string) => base + s;
const posts = await getCollection('blog', ({ data }) => !data.draft);
const connect = ([['LinkedIn', site.links.linkedin], ['Microsoft MVP profile', site.links.mvp], ['GitHub', site.links.github]] as [string, string][]).filter(([, h]) => h);
---
<Base
  title="Community & Microsoft MVP Recognition | Essam Shaaban"
  description={`Microsoft MVP in ${mvp.category} since ${mvp.firstAwarded}: sharing hands-on technical writing, architecture patterns and lessons learned with the Microsoft community.`}
  image="/og/home.jpg"
  imageAlt="Community and Microsoft MVP recognition — Essam Shaaban"
  jsonLd={[breadcrumbs([['Home', '/'], ['Community', '/community/']])]}
>
<section class="page-heading container">
  <span class="eyebrow">COMMUNITY / MICROSOFT MVP</span>
  <h1>Sharing what I learn,<br/><span class="gradient-text">with the community.</span></h1>
  <p>Hands-on technical writing, architecture patterns, and lessons learned — shared openly with the Microsoft ecosystem.</p>
</section>

<section class="section container" id="recognition">
  <MvpBanner headingLevel={2} />
</section>

<section class="section section-alt" id="contribute"><div class="container">
  <SectionHeading eyebrow="HOW I CONTRIBUTE" title="Knowledge, shared openly." subtitle="Ways I give back to the Microsoft community."/>
  <div class="info-grid">
    <a class="info-card" href={url('/blog/')}>
      <span class="tiny-label">TECHNICAL WRITING</span>
      <h3>Notes from the field</h3>
      <p>{posts.length} published articles on agentic AI, Power Platform and architecture — patterns, implementation guides and honest tradeoffs.</p>
      <span class="text-link">Read the blog <span aria-hidden="true">→</span></span>
    </a>
    <a class="info-card" href={abs('/rss.xml')}>
      <span class="tiny-label">FOLLOW ALONG</span>
      <h3>Subscribe via RSS</h3>
      <p>Get new articles in your feed reader as they are published.</p>
      <span class="text-link">RSS feed <span aria-hidden="true">↗</span></span>
    </a>
    <a class="info-card" href={url('/credentials/')}>
      <span class="tiny-label">LEARNING IN PUBLIC</span>
      <h3>Certifications</h3>
      <p>Continuous learning backed by Microsoft certifications, verified on Microsoft Learn.</p>
      <span class="text-link">View credentials <span aria-hidden="true">→</span></span>
    </a>
  </div>
  {connect.length > 0 && <div class="cert-actions">{connect.map(([label, href]) => <a class="button button-secondary" href={href} target="_blank" rel="noopener">{label} <span aria-hidden="true">↗</span></a>)}</div>}
</div></section>
</Base>
