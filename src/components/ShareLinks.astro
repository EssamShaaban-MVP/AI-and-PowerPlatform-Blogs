---
// Article sharing: LinkedIn share + copy link. No third-party scripts or trackers.
interface Props { url: string; title: string; label?: string }
const { url, title, label = 'Share this article' } = Astro.props;
const linkedin = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
---
<div class="share-links" role="group" aria-label={label}>
  <span class="share-label">{label}</span>
  <a class="share-btn" href={linkedin} target="_blank" rel="noopener" aria-label={`Share “${title}” on LinkedIn (opens in a new tab)`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg>
    <span>LinkedIn</span>
  </a>
  <button class="share-btn share-copy" type="button" data-url={url}>
    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4.5 4.5 0 0 0 6.4 0l3-3a4.5 4.5 0 0 0-6.4-6.4l-1 1"/><path d="M14 10a4.5 4.5 0 0 0-6.4 0l-3 3a4.5 4.5 0 0 0 6.4 6.4l1-1"/></svg>
    <span class="share-copy-text">Copy link</span>
  </button>
  <span class="share-status" aria-live="polite"></span>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const url = btn.dataset.url || location.href;
      let ok = false;
      try { await navigator.clipboard.writeText(url); ok = true; }
      catch {
        const ta = document.createElement('textarea');
        ta.value = url; ta.setAttribute('readonly', ''); ta.style.position = 'absolute'; ta.style.left = '-9999px';
        document.body.appendChild(ta); ta.select();
        try { ok = document.execCommand('copy'); } catch { ok = false; }
        ta.remove();
      }
      const text = btn.querySelector('.share-copy-text');
      const status = btn.parentElement?.querySelector('.share-status');
      if (text) text.textContent = ok ? 'Link copied' : 'Copy failed';
      if (status) status.textContent = ok ? 'Article link copied to clipboard' : 'Could not copy the link';
      btn.classList.toggle('is-copied', ok);
      setTimeout(() => { if (text) text.textContent = 'Copy link'; btn.classList.remove('is-copied'); if (status) status.textContent = ''; }, 2200);
    });
  });
</script>
