---
// "Credentials at a glance" ring infographic. Every number is computed from src/data/site.ts.
import { site, certifications, mvp } from '../data/site';
const total = certifications.length;
const active = certifications.filter(c => c.status === 'active').length;
const roleBased = certifications.filter(c => c.level === 'Expert' || c.level === 'Associate').length;
const R = 42, C = 2 * Math.PI * R;
const stats = [
  { value: String(total), label: 'Microsoft certifications earned', ratio: 1 },
  { value: String(active), label: 'Currently active', ratio: active / total },
  { value: String(roleBased), label: 'Role-based (Expert + Associate)', ratio: roleBased / total },
  { value: String(mvp.firstAwarded), label: "Microsoft MVP since", ratio: 1, small: true },
];
const verify = site.links.learnTranscript;
---
<div class="cred-stats">
  <div class="cred-stats-head">
    <h3>Credentials at a glance</h3>
    <p>Counted from my Microsoft Learn transcript and Microsoft MVP profile.{verify && <> <a href={verify} target="_blank" rel="noopener">Verify on Microsoft Learn <span aria-hidden="true">↗</span></a></>}</p>
  </div>
  <ul class="cred-rings">
    {stats.map(s => (
      <li>
        <svg viewBox="0 0 100 100" aria-hidden="true">
          <circle class="ring-track" cx="50" cy="50" r={R} />
          <circle class="ring-value" cx="50" cy="50" r={R} stroke-dasharray={`${(C * s.ratio).toFixed(1)} ${C.toFixed(1)}`} transform="rotate(-90 50 50)" />
        </svg>
        <strong class:list={['ring-num', s.small && 'ring-num-sm']}>{s.value}</strong>
        <span class="ring-label">{s.label}</span>
      </li>
    ))}
  </ul>
</div>
