---
// Consistent 24px line icons (1.6 stroke, round caps) used for project and article artwork.
interface Props { name: string; class?: string }
const { name, class: cls } = Astro.props;
const paths: Record<string, string> = {
  sparkles: '<path d="M12 3l1.8 4.6L18.4 9.4l-4.6 1.8L12 15.8l-1.8-4.6L5.6 9.4l4.6-1.8z"/><path d="M18.5 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7z"/>',
  workflow: '<rect x="3" y="3.5" width="7" height="5" rx="1.5"/><rect x="14" y="15.5" width="7" height="5" rx="1.5"/><path d="M6.5 8.5v4a2.5 2.5 0 0 0 2.5 2.5h5"/><path d="M12 12.5l2.5 2.5-2.5 2.5"/>',
  network: '<circle cx="12" cy="5" r="2.2"/><circle cx="5" cy="18" r="2.2"/><circle cx="19" cy="18" r="2.2"/><circle cx="12" cy="12.5" r="1.6"/><path d="M12 7.2v3.7M10.7 13.6l-4.1 3M13.3 13.6l4.1 3"/>',
  files: '<path d="M8 3.5h7l4 4v10a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 17.5v-12.5A1.5 1.5 0 0 1 8 3.5z"/><path d="M15 3.5v4h4"/><path d="M3.5 7.5v12A1.5 1.5 0 0 0 5 21h9"/><path d="M9.5 12h6M9.5 15h4"/>',
  layers: '<path d="M12 3.5l8.5 4.5-8.5 4.5L3.5 8z"/><path d="M3.5 12.2l8.5 4.5 8.5-4.5"/><path d="M3.5 16.2l8.5 4.5 8.5-4.5"/>',
};
const svg = paths[name] ?? paths.layers;
---
<svg class:list={['icon', cls]} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={svg} />
