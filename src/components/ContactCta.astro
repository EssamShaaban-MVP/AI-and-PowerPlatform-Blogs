---
// Shared "Let's connect" call-to-action, rendered once by the Base layout (id="contact").
import { site } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const links = ([['Connect on LinkedIn', site.links.linkedin], ['Email me', site.links.email && 'mailto:' + site.links.email], ['MVP profile', site.links.mvp], ['GitHub', site.links.github]] as [string, string][]).filter(([, h]) => h);
---
<section class="contact-section" id="contact"><div class="container contact-inner"><span class="eyebrow">LET'S CONNECT</span><h2>Let's build something<br/><span class="gradient-text">meaningful.</span></h2><p>Interested in AI architecture, Power Platform, technical collaboration or community speaking? I'd be glad to connect.</p><div class="contact-actions">{links.length ? links.map(([label, href], i) => <a class:list={['button', i === 0 ? 'button-primary' : 'button-secondary']} href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noopener' : undefined}>{label} <span aria-hidden="true">↗</span></a>) : <a class="button button-primary" href={base + '/blog/'}>Read my articles <span aria-hidden="true">→</span></a>}</div></div></section>
