---
// Shared "Let's connect" call-to-action, rendered once by the Base layout (id="contact").
// Left: the invitation. Right: one card per way to connect (only links that are set in src/data/site.ts).
import { site, mvp } from '../data/site';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// LinkedIn is the official "in" mark (filled); the other icons are simple outlines. The MVP card uses the real award badge.
const icons: Record<string, string> = {
  linkedin: '<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  mail: '<path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/>',
  award: '<circle cx="12" cy="9" r="6"/><path d="M8.500 14.500 7 22l5-3 5 3-1.500-7.500"/>',
  code: '<path d="m8 7-5 5 5 5M16 7l5 5-5 5M14 4l-4 16"/>',
};
type Way = { title: string; sub: string; href: string; icon: string; solid?: boolean; badge?: string };
const ways: Way[] = [
  site.links.linkedin && { title: 'Connect on LinkedIn', sub: 'Professional network', href: site.links.linkedin, icon: 'linkedin', solid: true },
  site.links.email && { title: 'Email me', sub: site.links.email, href: 'mailto:' + site.links.email, icon: 'mail' },
  site.links.mvp && { title: 'Microsoft MVP profile', sub: 'Business Applications', href: site.links.mvp, icon: 'award', badge: base + mvp.badgeSmall },
  site.links.github && { title: 'GitHub', sub: 'Code and projects', href: site.links.github, icon: 'code' },
].filter(Boolean) as Way[];
---
<section class="contact-section" id="contact">
  <div class="container contact-inner">
    <div class="contact-copy">
      <span class="eyebrow">LET'S CONNECT</span>
      <h2>Let's build something<br/><span class="gradient-text">meaningful.</span></h2>
      <p>Interested in AI architecture, Power Platform, technical collaboration or community speaking? I'd be glad to connect.</p>
      {!ways.length && <div class="contact-actions"><a class="button button-primary" href={base + '/#writing'}>Read my articles <span aria-hidden="true">→</span></a></div>}
    </div>
    {ways.length > 0 && (
      <ul class="contact-ways">
        {ways.map(w => {
          const ext = w.href.startsWith('http');
          const filled = w.icon === 'linkedin' || w.icon === 'mail';
          return (
            <li>
              <a class={`contact-way${w.solid ? ' is-primary' : ''}`} href={w.href} target={ext ? '_blank' : undefined} rel={ext ? 'noopener' : undefined}>
                <span class={`contact-way-icon${filled ? ' is-glyph' : ''}${w.badge ? ' is-badge' : ''}`} aria-hidden="true">
                  {w.badge ? <img src={w.badge} alt="" width="36" height="36" loading="lazy" /> : <svg viewBox="0 0 24 24" width="22" height="22" fill={filled ? 'currentColor' : 'none'} stroke={filled ? 'none' : 'currentColor'} stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[w.icon]} />}
                </span>
                <span class="contact-way-text"><strong>{w.title}</strong><small>{w.sub}</small></span>
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>
