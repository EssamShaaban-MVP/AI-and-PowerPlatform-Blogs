        else { cube.rotation.x = lerp(cube.rotation.x, Math.round(cube.rotation.x / (Math.PI / 2)) * (Math.PI / 2), Math.min(1, dt * 8)); cube.rotation.y = lerp(cube.rotation.y, Math.round(cube.rotation.y / (Math.PI / 2)) * (Math.PI / 2), Math.min(1, dt * 8)); }
