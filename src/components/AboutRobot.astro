        d.fillStyle = '#e8f2ff'; d.font = font(700, 20); d.fillText('By robot', 682, 256);
        const names = ['Bolt · ingest', 'Nova · clean', 'Pixel · publish'], colors = ['#7fdcff', '#c4b5ff', '#7ff0e2'], bmax = Math.max(1, ...dash.perRobot);
        names.forEach((n, i) => {
