      monitor.rotation.y = -0.38; pedestal.rotation.y = 0.3;

      const font = (w: number, s: number) => `${w} ${s}px 'Urbanist Variable', 'Segoe UI', system-ui, sans-serif`;
      const dash = { quality: 61.4, packets: 0, perRobot: [0, 0, 0], history: Array.from({ length: 28 }, (_, i) => 3 + Math.sin(i / 3) * 1.5 + Math.random()), bucket: 0, log: [] as string[], latency: 142 };
