      const arc = (a: T.Vector3, b: T.Vector3, k: number, h: number) => cube.position.lerpVectors(a, b, k).setY(cube.position.y + Math.sin(Math.PI * k) * h);
      const ease = (k: number) => (k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2);
      const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
      const yawTargets = [0.55, 0, -0.55];

      function deliver() {
        dash.packets++; dash.bucket++; dash.quality += (99.8 - dash.quality) * 0.2; dash.perRobot = dash.perRobot.map(v => v + 1);
        dash.log.unshift(`Batch #${dash.packets} · pulled by Bolt, cleaned by Nova, published by Pixel · ${clock()}`);
        dash.log = dash.log.slice(0, 3);
        drawDashboard();
      }

      function work(dt: number) {
        const s = SEGS[seg];
        segT += dt / s.dur;
        const k = ease(Math.min(1, segT));
        const sc = robots[0].root.scale.x;
        robots.forEach(r => { r.holding = 0; r.reach = 0; });
        const targets = [...yawTargets];
        cubeFlying = s.kind === 'toss' || s.kind === 'pick' || s.kind === 'deliver';
        scanMat.opacity = 0;
        if (s.kind === 'spawn') { setClean(false); gather = k; pedTop(cube.position); cube.scale.setScalar(Math.max(0.01, k) * sc); targets[0] = -0.7; }
        else gather = Math.max(0, gather - dt * 2);
        if (s.kind === 'pick') { pedTop(tmpA); gripPos(0, tmpB); arc(tmpA, tmpB, k, 0.5 * sc); robots[0].reach = 1 - k; robots[0].holding = k; targets[0] = lerp(-0.7, 0.55, k); }
        if (s.kind === 'hold') {
