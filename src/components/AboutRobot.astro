      });
      host!.addEventListener('pointerleave', () => { pointer.active = false; });
      const placeBubble = () => {
        if (selected < 0) return;
        const p = toScreen(robots[selected].root.localToWorld(new THREE.Vector3(0, 3.6, 0)));
        const half = bubble.offsetWidth / 2 + 8;
        const left = Math.min(Math.max(p.x, half), host!.clientWidth - half);
        bubble.style.left = `${left}px`;
        // keep the pointer arrow over the robot that is speaking
        const arrow = Math.min(Math.max(p.x - (left - bubble.offsetWidth / 2), 18), bubble.offsetWidth - 18);
        bubble.style.setProperty('--ax', `${arrow}px`);
        bubble.style.top = `${Math.max(p.y, 70)}px`;
      };
      const select = (i: number) => {
        window.clearTimeout(hideTimer);
        const now = performance.now();
        if (i === selected && now - lastSelectAt < 400) return; // one gesture can fire focus + pointerenter + click
        lastSelectAt = now;
        const line = nextLine();
        selected = i;
        bubble.querySelector('strong')!.textContent = `${team[i].name} · ${line.kind}:`;
        bubble.querySelector('span')!.textContent = ` ${line.text}`;
        bubble.hidden = false; placeBubble();
        host!.classList.add('is-engaged');
        robots.forEach((r, k) => r.face.draw(k === i ? 'happy' : 'idle'));
        if (reduceMotion) render();
      };
      const release = () => {
        window.clearTimeout(hideTimer);
        hideTimer = window.setTimeout(() => { selected = -1; bubble.hidden = true; host!.classList.remove('is-engaged'); robots.forEach(r => r.face.draw('idle')); if (reduceMotion) render(); }, 2600);
      };
      hits.forEach((b, i) => {
        b.addEventListener('pointerenter', () => select(i));
        b.addEventListener('pointerleave', release);
        b.addEventListener('focus', () => select(i));
        b.addEventListener('blur', release);
        b.addEventListener('click', () => select(i));
      });

      // ---- Work cycle ----
      type Seg = { kind: 'spawn' | 'pick' | 'hold' | 'toss' | 'deliver'; from?: number; to?: number; dur: number };
      const SEGS: Seg[] = [
        { kind: 'spawn', dur: 0.5 }, { kind: 'pick', to: 0, dur: 0.55 }, { kind: 'hold', from: 0, dur: 0.4 },
        { kind: 'toss', from: 0, to: 1, dur: 0.75 }, { kind: 'hold', from: 1, dur: 1.1 },
        { kind: 'toss', from: 1, to: 2, dur: 0.75 }, { kind: 'hold', from: 2, dur: 0.35 }, { kind: 'deliver', from: 2, dur: 0.65 },
      ];
      let seg = 0, segT = 0, t = 0, cubeFlying = false;
      const tmpA = new THREE.Vector3(), tmpB = new THREE.Vector3();
      const handTmp = new THREE.Vector3();
