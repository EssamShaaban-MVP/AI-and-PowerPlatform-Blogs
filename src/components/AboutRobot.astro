        const entries = dash.log.length ? dash.log : ['Waiting for the first batch…'];
        entries.slice(0, 3).forEach((e, i) => {
          const y = 556 + i * 26;
          d.fillStyle = dash.log.length ? '#3ddc97' : '#7f97b1'; d.font = font(700, 18); d.fillText(dash.log.length ? '✓' : '•', 58, y);
          d.fillStyle = '#c9d7e6'; d.font = font(500, 18); d.fillText(e, 84, y);
        });
        dashTex.needsUpdate = true;
      }
      drawDashboard();
      document.fonts?.ready.then(drawDashboard);
      let dashTimer = 0;

      // The data cube
      const cubeTex = (clean: boolean) => {
        const c = document.createElement('canvas'); c.width = c.height = 128; const x = c.getContext('2d')!;
        if (clean) {
          x.fillStyle = '#1b6fa8'; x.fillRect(0, 0, 128, 128);
          x.strokeStyle = '#bff4ff'; x.lineWidth = 3; for (let i = 1; i < 4; i++) { x.beginPath(); x.moveTo(i * 32, 14); x.lineTo(i * 32, 114); x.stroke(); x.beginPath(); x.moveTo(14, i * 32); x.lineTo(114, i * 32); x.stroke(); }
          x.strokeStyle = '#ffffff'; x.lineWidth = 6; x.strokeRect(10, 10, 108, 108);
        } else {
          x.fillStyle = '#4a2418'; x.fillRect(0, 0, 128, 128);
          const cols = ['#ff7a59', '#ffc857', '#ff5c8a', '#a38aff', '#7a8597', '#4cc8ff'];
          for (let i = 0; i < 70; i++) { x.fillStyle = cols[i % cols.length]; x.globalAlpha = 0.5 + Math.random() * 0.5; x.fillRect(Math.random() * 120, Math.random() * 120, 4 + Math.random() * 22, 3 + Math.random() * 10); }
          x.globalAlpha = 1;
