      };
      const rawTex = cubeTex(false), cleanTex = cubeTex(true);
      const cubeMat = new THREE.MeshPhysicalMaterial({ color: 0xffffff, map: rawTex, emissive: 0xffffff, emissiveMap: rawTex, emissiveIntensity: 0.9, roughness: 0.15, metalness: 0.05, clearcoat: 1 });
      const cube = new THREE.Mesh(new RoundedBoxGeometry(0.38, 0.38, 0.38, 4, 0.08), cubeMat);
      world.add(cube);
      let isClean = false;
      const setClean = (c: boolean) => { if (c === isClean) return; isClean = c; cubeMat.map = cubeMat.emissiveMap = c ? cleanTex : rawTex; cubeMat.emissiveIntensity = c ? 1.3 : 0.9; };
      // Nova's cleaning scanner: a glowing ring sweeping over the cube
      const scanMat = new THREE.MeshBasicMaterial({ color: 0xc4b5ff, transparent: true, opacity: 0, blending: THREE.AdditiveBlending, depthWrite: false, toneMapped: false });
      const scanner = new THREE.Mesh(new THREE.TorusGeometry(0.34, 0.018, 8, 48), scanMat); scanner.rotation.x = Math.PI / 2; world.add(scanner);

      // ---- Layout (responsive) ----
      let spacing = 3.1;
      const layout = () => {
        const w = host!.clientWidth, h = host!.clientHeight; if (!w || !h) return;
        renderer.setSize(w, h, false);
        camera.aspect = w / h; camera.updateProjectionMatrix();
        const visibleW = 2 * Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)) * camera.position.z * camera.aspect;
        spacing = Math.min(3.1, (visibleW - 0.4) / 5.4);
        const s = Math.min(1, spacing / 3.1);
        robots.forEach((r, i) => { r.root.position.x = (i - 1) * spacing; r.root.scale.setScalar(s * 1.15); });
        pedestal.position.x = -spacing * 1.7; pedestal.scale.setScalar(s);
        monitor.position.x = spacing * 2.2; monitor.scale.setScalar(s * 1.35);
        cube.scale.setScalar(s * 1.15);
        placeHits();
      };
      const proj = new THREE.Vector3();
      const toScreen = (v: T.Vector3) => { proj.copy(v).project(camera); return { x: (proj.x + 1) / 2 * host!.clientWidth, y: (1 - proj.y) / 2 * host!.clientHeight }; };
      function placeHits() {
        robots.forEach((r, i) => {
          const top = toScreen(r.root.localToWorld(new THREE.Vector3(0, 3.4, 0)));
          const bot = toScreen(r.root.localToWorld(new THREE.Vector3(0, 0, 0)));
          const hh = Math.max(40, bot.y - top.y), ww = hh * 0.55;
          Object.assign(hits[i].style, { left: `${top.x - ww / 2}px`, top: `${top.y}px`, width: `${ww}px`, height: `${hh}px` });
        });
      }

      // ---- Interaction ----
      let selected = -1, attention = 0, hideTimer = 0, lastSelectAt = 0;
      const pointer = { x: 0, y: 0, active: false };
      host!.addEventListener('pointermove', e => {
        const r = host!.getBoundingClientRect();
