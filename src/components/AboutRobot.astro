          else { const dx = cube.position.x - r.root.position.x; hy = Math.max(-0.6, Math.min(0.6, dx * 0.18)) - r.yaw * 0.5; hx = Math.max(-0.3, Math.min(0.3, -(cube.position.y - 1.9) * 0.12)); }
          r.head.rotation.y = lerp(r.head.rotation.y, hy, Math.min(1, dt * 7));
          r.head.rotation.x = lerp(r.head.rotation.x, hx, Math.min(1, dt * 7));
