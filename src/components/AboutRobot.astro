---
// Decorative 3D robot team (Three.js / WebGL) in the About section.
// - Three modern robots pass a glowing data cube along: dispenser → Bolt → Nova → Pixel → live dashboard monitor.
// - The monitor shows a canvas-rendered dashboard (simulated demo data) that updates with every delivery.
// - Hover, tap or keyboard-focus a robot: the team stops, looks at you, and that robot shares a tip or a joke
//   (shuffled deck: every interaction shows a different line until all have been seen).
// - Three.js is loaded lazily when the section approaches the viewport; rendering pauses off-screen.
// - prefers-reduced-motion: a still scene (tips/jokes still work); hidden if WebGL is unavailable.
const team = [
  { name: 'Bolt', role: 'Data dispatcher' },
  { name: 'Nova', role: 'Orchestrator' },
  { name: 'Pixel', role: 'Deployer' },
];
---
<div class="about-robot" data-team={JSON.stringify(team)}>
  <canvas aria-hidden="true"></canvas>
  {team.map((r, i) => (
    <button class="rb-hit" type="button" data-index={i} aria-label={`Ask ${r.name} the robot for a tip or a joke`}></button>
  ))}
  <div class="rb-bubble" role="status" aria-live="polite" hidden><strong></strong><span></span></div>
</div>

<script>
  import type * as T from 'three';

  const JOKES = [
    'Why did the AI agent cross the road? It was grounded on the other side.',
    "I'm not lazy. I'm running in low-power mode.",
    'Dataverse and I have a one-to-many relationship. With snacks.',
    "There are 10 kinds of robots: those who get binary and those who don't.",
    'My Power Automate flow and I have a lot in common. We only work when triggered.',
    'I asked Copilot for a joke. It gave me three options and a summary.',
    "Why don't robots panic? Built-in retry policy.",
    "I'd tell you a UDP joke, but you might not get it.",
    "We're a great team. Low-code, high-five!",
    "Our sprint had zero bugs. We just haven't found them yet.",
  ];
  const ADVICE = [
    'Start with the problem, not the tool.',
    'Secure it first. Least privilege beats clever code.',
    'Automate the boring parts, then document them.',
    'Ship small, learn fast, improve often.',
    'Ground your AI in good data. Garbage in, confident garbage out.',
    'Name things clearly. Future you will say thanks.',
    'Design for the people using it, not the org chart.',
    'Measure what matters before you optimise.',
    'Every great solution started as a simple prototype.',
    "Ask 'who will maintain this?' before you build it.",
    'Keep learning. One Microsoft Learn module a week adds up.',
    'Good governance is a feature, not a blocker.',
    "Test the unhappy path. That's where real users live.",
    'Write it down. The best architecture is a shared one.',
    'Take breaks. Even robots need to recharge.',
  ];
  type Line = { kind: 'Tip' | 'Joke'; text: string };
  const ALL: Line[] = [...ADVICE.map(text => ({ kind: 'Tip' as const, text })), ...JOKES.map(text => ({ kind: 'Joke' as const, text }))];
  let deck: Line[] = [];
  let lastLine: Line | null = null;
  const nextLine = (): Line => {
    if (!deck.length) {
      deck = [...ALL];
      for (let i = deck.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [deck[i], deck[j]] = [deck[j], deck[i]]; }
      if (lastLine && deck[deck.length - 1] === lastLine) deck.unshift(deck.pop()!);
    }
    lastLine = deck.pop()!;
    return lastLine;
  };

  const host = document.querySelector<HTMLElement>('.about-robot');
  if (host) {
    const team: { name: string; role: string }[] = JSON.parse(host.dataset.team || '[]');
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const bubble = host.querySelector<HTMLElement>('.rb-bubble')!;
    const hits = [...host.querySelectorAll<HTMLButtonElement>('.rb-hit')];
    let started = false, visible = false;

    const io = new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible && !started) { started = true; init().catch(() => { host.hidden = true; }); }
    }, { rootMargin: '300px 0px' });
    io.observe(host);

    async function init() {
      const THREE = await import('three');
      const { RoundedBoxGeometry } = await import('three/examples/jsm/geometries/RoundedBoxGeometry.js');
      const { RoomEnvironment } = await import('three/examples/jsm/environments/RoomEnvironment.js');
      const canvas = host!.querySelector('canvas')!;

      let renderer: T.WebGLRenderer;
      try { renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'low-power' }); }
      catch { host!.hidden = true; return; }
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.0;

      const scene = new THREE.Scene();
      const pmrem = new THREE.PMREMGenerator(renderer);
      scene.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture; // studio reflections

      const camera = new THREE.PerspectiveCamera(26, 1, 0.1, 100);
      camera.position.set(0, 2.7, 12.5);
      camera.lookAt(0, 1.55, 0);
      scene.add(new THREE.HemisphereLight(0xe6f1ff, 0x22324f, 0.6));
      const key = new THREE.DirectionalLight(0xffffff, 1.6); key.position.set(3.5, 6, 6); scene.add(key);
      const rim = new THREE.DirectionalLight(0x4cc8ff, 1.4); rim.position.set(-5, 3, -4); scene.add(rim);

      // Shared materials: pearl clear-coat shell, graphite metal, dark glass, brushed aluminium
      const shell = new THREE.MeshPhysicalMaterial({ color: 0xf5f8fc, roughness: 0.2, metalness: 0, clearcoat: 1, clearcoatRoughness: 0.06, iridescence: 0.18, iridescenceIOR: 1.3, sheen: 0.25, sheenColor: new THREE.Color(0xbfe3ff) });
      const graphite = new THREE.MeshPhysicalMaterial({ color: 0x1c2532, roughness: 0.32, metalness: 0.75, clearcoat: 0.4, clearcoatRoughness: 0.3 });
      const glass = new THREE.MeshPhysicalMaterial({ color: 0x050b16, roughness: 0.04, metalness: 0.2, clearcoat: 1, clearcoatRoughness: 0.02 });
      const alu = new THREE.MeshPhysicalMaterial({ color: 0xc9d2dd, roughness: 0.28, metalness: 1 });

      // Soft contact shadow texture
      const sc = document.createElement('canvas'); sc.width = sc.height = 128;
      const sx = sc.getContext('2d')!; const sg = sx.createRadialGradient(64, 64, 4, 64, 64, 64);
      sg.addColorStop(0, 'rgba(6,18,45,0.42)'); sg.addColorStop(1, 'rgba(6,18,45,0)'); sx.fillStyle = sg; sx.fillRect(0, 0, 128, 128);
      const shadowMat = new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(sc), transparent: true, depthWrite: false });
      const contactShadow = (w: number, dd: number) => { const m = new THREE.Mesh(new THREE.PlaneGeometry(w, dd), shadowMat); m.rotation.x = -Math.PI / 2; m.position.y = 0.01; return m; };

      // Screen face: a canvas drawn as the emissive map of the curved visor, so the eyes glow on the dark glass.
      type Face = 'idle' | 'blink' | 'happy';
      function makeFace(color: string) {
        const c = document.createElement('canvas'); c.width = 384; c.height = 208;
        const ctx = c.getContext('2d')!;
        const tex = new THREE.CanvasTexture(c); tex.colorSpace = THREE.SRGBColorSpace;
        let current: Face | null = null;
        const draw = (mode: Face) => {
          if (mode === current) return; current = mode;
          ctx.fillStyle = '#000'; ctx.fillRect(0, 0, 384, 208);           // black = no emission
          ctx.fillStyle = color; ctx.strokeStyle = color; ctx.shadowColor = color; ctx.shadowBlur = 28; ctx.lineCap = 'round';
          const eyes = [132, 252];
          if (mode === 'blink') { ctx.lineWidth = 12; eyes.forEach(x => { ctx.beginPath(); ctx.moveTo(x - 24, 98); ctx.lineTo(x + 24, 98); ctx.stroke(); }); }
          else if (mode === 'happy') { ctx.lineWidth = 14; eyes.forEach(x => { ctx.beginPath(); ctx.arc(x, 112, 27, Math.PI * 1.15, Math.PI * 1.85); ctx.stroke(); }); }
          else { eyes.forEach(x => { ctx.beginPath(); ctx.ellipse(x, 96, 27, 30, 0, 0, Math.PI * 2); ctx.fill(); }); }
          // small smile under the eyes (wider when happy)
          ctx.lineWidth = 9; ctx.beginPath();
          if (mode === 'happy') ctx.arc(192, 128, 26, Math.PI * 0.18, Math.PI * 0.82); else ctx.arc(192, 120, 16, Math.PI * 0.25, Math.PI * 0.75);
          ctx.stroke();
          tex.needsUpdate = true;
        };
        draw('idle');
        return { tex, draw };
      }

      // Rounded alpha mask so the visor reads as a soft, pill-shaped screen
      const roundedMask = (inset: number, radius: number) => {
        const c = document.createElement('canvas'); c.width = 384; c.height = 208;
        const x = c.getContext('2d')!; x.fillStyle = '#000'; x.fillRect(0, 0, 384, 208);
        x.fillStyle = '#fff'; x.beginPath(); x.roundRect(inset, inset, 384 - inset * 2, 208 - inset * 2, radius); x.fill();
        return new THREE.CanvasTexture(c);
      };
      const visorMask = roundedMask(4, 80), rimMask = roundedMask(2, 86);

      // Squircle (superellipsoid) helmet: deform a sphere so the head is a soft rounded cube, with exact normals.
      const HX = 0.92, HY = 0.76, HZ = 0.8, HN = 3.2;
      const squircle = (geo: T.BufferGeometry) => {
        const pos = geo.attributes.position, nor = geo.attributes.normal, v = new THREE.Vector3(), n = new THREE.Vector3();
        for (let i = 0; i < pos.count; i++) {
          v.fromBufferAttribute(pos, i); const r = v.length(); if (!r) continue; v.divideScalar(r);
          const k = Math.pow(Math.abs(v.x) ** HN + Math.abs(v.y) ** HN + Math.abs(v.z) ** HN, 1 / HN);
          v.multiplyScalar(r / k); v.set(v.x * HX, v.y * HY, v.z * HZ); pos.setXYZ(i, v.x, v.y, v.z);
          const g = (c: number, ax: number) => Math.sign(c) * Math.abs(c / ax) ** (HN - 1) / ax;
          n.set(g(v.x, HX), g(v.y, HY), g(v.z, HZ)).normalize(); nor.setXYZ(i, n.x, n.y, n.z);
        }
        pos.needsUpdate = true; nor.needsUpdate = true; return geo;
      };

      type Robot = {
        root: T.Group; body: T.Group; head: T.Group; grip: T.Object3D; arms: T.Group[]; elbows: T.Group[]; legs: T.Group[]; knees: T.Group[];
        accent: T.MeshStandardMaterial; tip: T.MeshStandardMaterial; face: ReturnType<typeof makeFace>;
        yaw: number; nextBlink: number; holding: number;
        hands: T.Group[]; reach: number; recoil: number; throwT: number;
      };
      const chrome = new THREE.MeshPhysicalMaterial({ color: 0x9aa7b8, roughness: 0.18, metalness: 1, clearcoat: 0.6 });
      const darkJoint = new THREE.MeshPhysicalMaterial({ color: 0x1a2230, roughness: 0.3, metalness: 0.4, clearcoat: 0.8, clearcoatRoughness: 0.1 });
      const cap = (r: number, l: number) => new THREE.CapsuleGeometry(r, l, 8, 18);
      const ball = (r: number) => new THREE.SphereGeometry(r, 24, 18);
      // short, round egg body (lathe)
      const torsoGeo = new THREE.LatheGeometry([
        [0, 0], [0.22, 0.01], [0.33, 0.08], [0.41, 0.25], [0.43, 0.46], [0.41, 0.66], [0.34, 0.84], [0.22, 0.96], [0.1, 1.0], [0, 1.0],
      ].map(([x, y]) => new THREE.Vector2(x, y)), 48);

      type Look = 'antenna' | 'cat' | 'headset';
      function makeRobot(accentHex: number, accentCss: string, look: Look): Robot {
        const accent = new THREE.MeshStandardMaterial({ color: accentHex, emissive: accentHex, emissiveIntensity: 2.4, toneMapped: false });
        const tip = accent.clone();
        const root = new THREE.Group(); const body = new THREE.Group(); root.add(body);

        // body: small glossy egg, dark belly band with a glowing light, glowing chest chevron
        const torso = new THREE.Mesh(torsoGeo, shell); torso.scale.set(0.9, 0.85, 0.82); torso.position.y = 0.58; body.add(torso);
        const belt = new THREE.Mesh(new THREE.TorusGeometry(0.355, 0.05, 12, 56), darkJoint); belt.rotation.x = Math.PI / 2; belt.scale.set(1, 0.82, 1); belt.position.y = 0.8; body.add(belt);
        const beltLight = new THREE.Mesh(new RoundedBoxGeometry(0.2, 0.035, 0.04, 2, 0.017), accent); beltLight.position.set(0, 0.8, 0.325); body.add(beltLight);
        [-1, 1].forEach(sd => { const v = new THREE.Mesh(new RoundedBoxGeometry(0.13, 0.035, 0.03, 2, 0.015), accent); v.position.set(sd * 0.05, 1.14, 0.3); v.rotation.set(-0.35, 0, sd * 0.55); body.add(v); });
        const pelvis = new THREE.Mesh(ball(0.26), shell); pelvis.scale.set(1.1, 0.55, 0.9); pelvis.position.y = 0.6; body.add(pelvis);
        const collar = new THREE.Mesh(new THREE.CylinderGeometry(0.16, 0.2, 0.12, 28), darkJoint); collar.position.y = 1.46; body.add(collar);

        // head: big squircle helmet with a dark wrap-around screen
        const head = new THREE.Group(); head.position.y = 1.5; body.add(head);
        const HC = 0.78;                                                         // helmet centre above the neck
        const skull = new THREE.Mesh(squircle(new THREE.SphereGeometry(1, 72, 56)), shell); skull.position.y = HC; head.add(skull);
        const seg = (r: number, w: number, h: number, mat: T.Material) => {
          const m = new THREE.Mesh(squircle(new THREE.SphereGeometry(r, 72, 44, Math.PI / 2 - w / 2, w, Math.PI / 2 - h * 0.52, h)), mat);
          m.position.y = HC; return m;
        };
        head.add(seg(1.006, 2.08, 1.36, new THREE.MeshPhysicalMaterial({ color: 0x1a2230, roughness: 0.3, metalness: 0.4, clearcoat: 0.8, alphaMap: rimMask, alphaTest: 0.5 }))); // screen bezel
        const face = makeFace(accentCss);
        const visorMat = new THREE.MeshPhysicalMaterial({ color: 0x03060c, roughness: 0.05, metalness: 0.2, clearcoat: 1, clearcoatRoughness: 0.02, emissive: 0xffffff, emissiveMap: face.tex, emissiveIntensity: 2.6, alphaMap: visorMask, alphaTest: 0.5 });
        head.add(seg(1.012, 1.96, 1.24, visorMat));                              // glossy black screen with glowing eyes
        const shine = new THREE.Mesh(squircle(new THREE.SphereGeometry(1.02, 48, 16, Math.PI / 2 - 0.75, 0.55, Math.PI / 2 - 0.55, 0.16)),
          new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.2, depthWrite: false }));
        shine.position.y = HC; head.add(shine);                                  // soft reflection on the screen
        // headphone ear pods: dark housing, white cap, glowing ring
        [-1, 1].forEach(sd => {
          const pod = new THREE.Group(); pod.position.set(sd * 0.9, HC - 0.02, -0.02); pod.rotation.z = Math.PI / 2; head.add(pod);
          pod.add(new THREE.Mesh(new THREE.CylinderGeometry(0.28, 0.3, 0.16, 44), darkJoint));
          const capM = new THREE.Mesh(new THREE.CylinderGeometry(0.2, 0.22, 0.08, 44), shell); capM.position.y = -sd * 0.1; pod.add(capM);
          const ring = new THREE.Mesh(new THREE.TorusGeometry(0.245, 0.016, 8, 44), accent); ring.rotation.x = Math.PI / 2; ring.position.y = -sd * 0.085; pod.add(ring);
        });
        // personality: Bolt has antennas, Nova cat ears, Pixel a headset band
        if (look === 'antenna') {
          [-1, 1].forEach(sd => {
            const ant = new THREE.Group(); ant.position.set(sd * 0.86, HC + 0.1, -0.02); ant.rotation.z = -sd * 0.12; head.add(ant);
            const rod = new THREE.Mesh(new THREE.CylinderGeometry(0.018, 0.022, 0.62, 12), chrome); rod.position.y = 0.42; ant.add(rod);
            const bulb = new THREE.Mesh(ball(0.055), tip); bulb.position.y = 0.76; ant.add(bulb);
          });
        } else if (look === 'cat') {
          [-1, 1].forEach(sd => {
            const ear = new THREE.Group(); ear.position.set(sd * 0.52, HC + 0.66, -0.05); ear.rotation.z = -sd * 0.42; head.add(ear);
            const outer = new THREE.Mesh(new THREE.ConeGeometry(0.27, 0.5, 32), shell); outer.scale.z = 0.55; outer.position.y = 0.2; ear.add(outer);
            const inner = new THREE.Mesh(new THREE.ConeGeometry(0.16, 0.32, 24), tip); inner.scale.z = 0.4; inner.position.set(0, 0.16, 0.08); ear.add(inner);
          });
        } else {
          const band = new THREE.Mesh(new THREE.TorusGeometry(0.95, 0.055, 14, 64, Math.PI), darkJoint); band.scale.y = 0.86; band.position.set(0, HC, -0.05); head.add(band);
          const bandLight = new THREE.Mesh(new THREE.TorusGeometry(0.95, 0.018, 8, 48, Math.PI * 0.22), tip); bandLight.scale.y = 0.86; bandLight.rotation.z = Math.PI * 0.39; bandLight.position.set(0, HC, 0.0); head.add(bandLight);
        }

        // stubby arms: shoulder, chunky upper arm, elbow, forearm with glowing cuff, dark mitten hand
        const elbows: T.Group[] = [];
        const hands: T.Group[] = [];
        const arms = [-1, 1].map(sd => {
          const sh = new THREE.Group(); sh.position.set(sd * 0.44, 1.3, 0); body.add(sh);
          sh.add(new THREE.Mesh(ball(0.12), darkJoint));
          const upper = new THREE.Mesh(cap(0.095, 0.12), shell); upper.position.y = -0.13; sh.add(upper);
          const elbow = new THREE.Group(); elbow.position.y = -0.28; sh.add(elbow); elbows.push(elbow);
          elbow.add(new THREE.Mesh(ball(0.085), darkJoint));
          const fore = new THREE.Mesh(cap(0.115, 0.12), shell); fore.position.y = -0.14; elbow.add(fore);
          const cuff = new THREE.Mesh(new THREE.TorusGeometry(0.1, 0.016, 8, 28), accent); cuff.rotation.x = Math.PI / 2; cuff.position.y = -0.26; elbow.add(cuff);
          const hand = new THREE.Group(); hand.position.y = -0.36; elbow.add(hand); hands.push(hand);
          hand.add(new THREE.Mesh(new RoundedBoxGeometry(0.19, 0.17, 0.15, 3, 0.065), darkJoint));
          const thumb = new THREE.Mesh(cap(0.035, 0.05), darkJoint); thumb.position.set(-sd * 0.1, 0.0, 0.04); thumb.rotation.z = sd * 0.7; hand.add(thumb);
          return sh;
        });

        // short legs with big rounded boots
        const knees: T.Group[] = [];
        const legs = [-1, 1].map(sd => {
          const hip = new THREE.Group(); hip.position.set(sd * 0.19, 0.55, 0); root.add(hip);
          hip.add(new THREE.Mesh(ball(0.1), darkJoint));
          const thigh = new THREE.Mesh(cap(0.105, 0.06), shell); thigh.position.y = -0.1; hip.add(thigh);
          const knee = new THREE.Group(); knee.position.y = -0.22; hip.add(knee); knees.push(knee);
          knee.add(new THREE.Mesh(ball(0.085), darkJoint));
          const shin = new THREE.Mesh(new THREE.CylinderGeometry(0.11, 0.14, 0.14, 28), shell); shin.position.y = -0.08; knee.add(shin);
          const boot = new THREE.Mesh(new RoundedBoxGeometry(0.32, 0.2, 0.44, 4, 0.09), shell); boot.position.set(0, -0.22, 0.05); knee.add(boot);
          const sole = new THREE.Mesh(new RoundedBoxGeometry(0.33, 0.05, 0.45, 3, 0.022), darkJoint); sole.position.set(0, -0.305, 0.05); knee.add(sole);
          return hip;
        });

        const grip = new THREE.Object3D(); grip.position.set(0, 1.0, 0.6); body.add(grip);
        root.add(contactShadow(2.0, 1.15));
        return { root, body, head, grip, arms, elbows, legs, knees, accent, tip, face, yaw: 0, nextBlink: 1 + Math.random() * 3, holding: 0, hands, reach: 0, recoil: 0, throwT: 0 };
      }

      const world = new THREE.Group(); scene.add(world);
      const robots = [makeRobot(0x4cc8ff, '#7fdcff', 'antenna'), makeRobot(0xa38aff, '#c4b5ff', 'cat'), makeRobot(0x3ad6c4, '#7ff0e2', 'headset')];
      robots.forEach(r => world.add(r.root));

      // ---- Raw data source: a tangled, chaotic cloud of mixed records above a hex platform ----
      const pedestal = new THREE.Group(); world.add(pedestal);
      const RAW = 0xff7a59;
      const plat = new THREE.Mesh(new THREE.CylinderGeometry(0.62, 0.7, 0.16, 6), graphite); plat.position.y = 0.08; pedestal.add(plat);
      const platTop = new THREE.Mesh(new THREE.CylinderGeometry(0.6, 0.6, 0.02, 6), glass); platTop.position.y = 0.17; pedestal.add(platTop);
      const platGlow = new THREE.Mesh(new THREE.TorusGeometry(0.61, 0.018, 8, 6), new THREE.MeshStandardMaterial({ color: RAW, emissive: RAW, emissiveIntensity: 2.4, toneMapped: false }));
      platGlow.rotation.set(Math.PI / 2, 0, Math.PI / 2); platGlow.position.y = 0.17; pedestal.add(platGlow);
      const CL = 1.8;                                                            // cloud centre height
      const chaos = new THREE.Group(); chaos.position.y = CL; chaos.scale.setScalar(1.6); pedestal.add(chaos);
      // light cone from the platform up into the cloud
      const beamMat = new THREE.MeshBasicMaterial({ color: RAW, transparent: true, opacity: 0.1, blending: THREE.AdditiveBlending, depthWrite: false, side: THREE.DoubleSide });
      const beam = new THREE.Mesh(new THREE.CylinderGeometry(0.5, 0.56, CL - 0.2, 6, 1, true), beamMat); beam.position.y = (CL + 0.2) / 2 - 0.0; pedestal.add(beam);
      // glowing core
      const coreMat = new THREE.MeshBasicMaterial({ color: RAW, transparent: true, opacity: 0.3, depthWrite: false, toneMapped: false });
      const core = new THREE.Mesh(new THREE.SphereGeometry(0.26, 24, 16), coreMat); chaos.add(core);
      // ~100 mismatched records orbiting on random axes (instanced)
      const NB = 100, bitPalette = [0xff7a59, 0xffc857, 0xff5c8a, 0x4cc8ff, 0xa38aff, 0x9aa7b8, 0x3ad6c4];
      const bits = new THREE.InstancedMesh(new RoundedBoxGeometry(0.1, 0.1, 0.1, 1, 0.022), new THREE.MeshStandardMaterial({ roughness: 0.35, metalness: 0.1, emissive: 0x2a1610, emissiveIntensity: 1 }), NB);
      const bitInfo = Array.from({ length: NB }, (_, i) => {
        const axis = new THREE.Vector3(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).normalize();
        const u = new THREE.Vector3(1, 0, 0).cross(axis); if (u.lengthSq() < 0.01) u.set(0, 1, 0).cross(axis); u.normalize();
        const v = axis.clone().cross(u);
        bits.setColorAt(i, new THREE.Color(bitPalette[i % bitPalette.length]));
        return { u, v, r: 0.2 + Math.random() * 0.55, speed: (0.4 + Math.random() * 1.4) * (Math.random() < 0.5 ? -1 : 1), ph: Math.random() * Math.PI * 2,
          sc: new THREE.Vector3(0.5 + Math.random() * 1.3, 0.4 + Math.random() * 1.0, 0.5 + Math.random() * 1.2), spin: Math.random() * 3 };
      });
      chaos.add(bits);
      // tangled data streams
      const tangles: T.Mesh[] = [];
      [0xff7a59, 0xffc857, 0xff5c8a, 0xa38aff, 0x4cc8ff].forEach(col => {
        const pts = Array.from({ length: 9 }, () => new THREE.Vector3(Math.random() - 0.5, Math.random() - 0.5, Math.random() - 0.5).normalize().multiplyScalar(0.3 + Math.random() * 0.38));
        const line = new THREE.Mesh(new THREE.TubeGeometry(new THREE.CatmullRomCurve3(pts, true), 160, 0.011, 6, true),
          new THREE.MeshBasicMaterial({ color: col, transparent: true, opacity: 0.85, toneMapped: false }));
        line.rotation.set(Math.random() * 3, Math.random() * 3, 0); chaos.add(line); tangles.push(line);
      });
      pedestal.add(contactShadow(2.1, 1.3));
      let gather = 0;                                                            // records pull together while a cube forms
      const bitDummy = new THREE.Object3D();
      const animateChaos = (dt: number) => {
        bitInfo.forEach((bi, i) => {
          const ang = bi.ph + t * bi.speed, r = bi.r * (1 - gather * 0.5) + Math.sin(t * 5 + i) * 0.015;
