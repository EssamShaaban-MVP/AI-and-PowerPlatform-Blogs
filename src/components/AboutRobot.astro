          r.legs[0].rotation.x = Math.sin(t * 2.2 + i) * 0.07; r.legs[1].rotation.x = -Math.sin(t * 2.2 + i) * 0.07;
          r.knees.forEach((k, n) => { k.rotation.x = Math.max(0, (n ? -1 : 1) * Math.sin(t * 2.2 + i)) * 0.12 + r.recoil * 0.25; });
          r.body.position.y = waving ? Math.abs(Math.sin(t * 7)) * 0.16 : Math.sin(t * 2 + i) * 0.025 - r.recoil * 0.07;
          r.tip.emissiveIntensity = (waving ? 4.5 : 2) + Math.sin(t * 3 + i) * 0.8;
          r.accent.emissiveIntensity = 2.2 + (hold ? 0.8 : 0) + Math.sin(t * 2 + i) * 0.2;
