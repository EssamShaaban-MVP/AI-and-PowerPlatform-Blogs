---
// Header brand mascot: a bold, simplified steel robot caught mid-stride (side view, running to the right).
// Chunky bright limbs with dark outlines and joint discs so it stays readable at a small size.
// Pure inline SVG, no JavaScript, no glows. It bobs gently; all motion stops when reduced motion is requested.
---
<svg class="brand-robot" viewBox="0 0 72 102" width="38" height="54" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="br-steel" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#e3edfb"/><stop offset="1" stop-color="#9cb6dc"/></linearGradient>
  </defs>
  <g class="br-run" stroke-linecap="round" stroke-linejoin="round">
    <!-- rear arm, swung back -->
    <path d="M31 17 L16.500 20.500 L6 33" fill="none" stroke="#0b1428" stroke-width="8.800"/><path d="M31 17 L16.500 20.500 L6 33" fill="none" stroke="url(#br-steel)" stroke-width="6.400"/>
    <circle cx="4.500" cy="36" r="3.800" fill="#0b1428"/>

    <!-- rear leg, pushing off -->
    <path d="M30 47 L24 69" fill="none" stroke="#0b1428" stroke-width="14"/><path d="M30 47 L24 69" fill="none" stroke="url(#br-steel)" stroke-width="11.200"/>
    <path d="M24 69 L11 89" fill="none" stroke="#0b1428" stroke-width="10.400"/><path d="M24 69 L11 89" fill="none" stroke="url(#br-steel)" stroke-width="7.600"/>
    <path d="M9.500 89.500 L14.500 100.500 L17.500 98.500 L14 88 Z" fill="#0b1428"/>

    <!-- torso -->
    <path d="M30 14.500 L50 18.500 L50 31 L39 36 L31.500 34 Z" fill="url(#br-steel)" stroke="#0b1428" stroke-width="1.400"/>
    <path d="M32 33.500 L39 36 L50 31 L49 34 L38.500 39 L32.500 37 Z" fill="#0b1428"/>
    <path d="M26 44 Q33 40 40 44.500 L38.500 52 L27 53 Z" fill="url(#br-steel)" stroke="#0b1428" stroke-width="1.400"/>

    <!-- head in profile with a cyan eye -->
    <path d="M36.500 6.500 Q37 -.5 45.500 .8 Q53 3 51.500 9.500 L50.500 13 Q46 16 41.500 13.800 Q36.500 11.500 36.500 6.500 Z" fill="url(#br-steel)" stroke="#0b1428" stroke-width="1.400"/>
    <circle cx="41" cy="6.500" r="3.200" fill="#0b1428"/>
    <rect x="46.500" y="5.200" width="4.600" height="2.600" rx="1.300" fill="#44d4ff"/>

    <!-- front leg: thigh drives forward, shin tucked back -->
    <path d="M31 47 L52.500 58" fill="none" stroke="#0b1428" stroke-width="14.400"/><path d="M31 47 L52.500 58" fill="none" stroke="url(#br-steel)" stroke-width="11.600"/>
    <path d="M52.500 58 L37.500 76" fill="none" stroke="#0b1428" stroke-width="10.400"/><path d="M52.500 58 L37.500 76" fill="none" stroke="url(#br-steel)" stroke-width="7.600"/>
    <path d="M35.500 76 L40.500 90 L44.500 88 L40.800 74.500 Z" fill="#0b1428"/>
    <circle cx="31" cy="47" r="5.200" fill="#0b1428"/><circle cx="31" cy="47" r="2" fill="#9cb6dc"/>
    <circle cx="52.500" cy="58" r="4.400" fill="#0b1428"/><circle cx="52.500" cy="58" r="1.700" fill="#9cb6dc"/>

    <!-- front arm, bent and pumping -->
    <path d="M50 22.500 L60.500 32 L65.500 19" fill="none" stroke="#0b1428" stroke-width="8.400"/><path d="M50 22.500 L60.500 32 L65.500 19" fill="none" stroke="url(#br-steel)" stroke-width="6"/>
    <circle cx="66" cy="16" r="3.800" fill="#0b1428"/>
    <circle cx="50" cy="22" r="4" fill="#0b1428"/><circle cx="33" cy="17" r="4" fill="#0b1428"/>
  </g>
</svg>
<style>
  .brand-robot{display:block;flex:none;overflow:visible;margin:0 2px}
  .br-run{animation:br-bob 1.1s ease-in-out infinite}
  @keyframes br-bob{0%,100%{transform:translateY(0)}50%{transform:translateY(-1.2px)}}
  @media (max-width:640px){.brand-robot{width:33px;height:47px}}
  @media (prefers-reduced-motion:reduce){.br-run{animation:none}}
</style>
