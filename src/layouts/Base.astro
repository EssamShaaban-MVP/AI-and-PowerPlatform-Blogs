---
import '../styles/global.css';
import { site } from '../data/site';
import { abs, graph, website, personRef } from '../lib/seo';
interface Props {
  title?: string; description?: string;
  image?: string; imageAlt?: string;          // site-relative path of a 1200x630 image
  type?: 'website' | 'article';
  published?: Date; modified?: Date; tags?: string[]; section?: string;
  jsonLd?: object[]; noindex?: boolean;
}
const {
  title = 'Essam Shaaban | Microsoft MVP · Power Platform & Agentic AI',
  description = site.intro,
  image = '/og/home.jpg',
  imageAlt = 'Essam Shaaban, Microsoft MVP and Senior Software Engineer',
  type = 'website', published, modified, tags = [], section, jsonLd = [], noindex = false,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base.replace(/\/$/, '')}${path}`;
const links = [ ['Home','/'], ['About','/#about'], ['Expertise','/#expertise'], ['Work','/#work'], ['Certifications','/certifications/'], ['Blog','/blog/'] ];
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = abs(image);
const current = Astro.url.pathname.replace(base.replace(/\/$/, ''), '') || '/';
const isCurrent = (path: string) => !path.includes('#') && path !== '/' && current.startsWith(path);
// Every page carries the WebSite entity; pages add their own entities through `jsonLd`.
const ld = JSON.stringify(graph(website, ...jsonLd)).replace(/</g, '\\u003c');
const verify = site.seo ?? {};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="theme-color" content="#070d1c" />
<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={site.name} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
<link rel="alternate" type="application/rss+xml" title={`${site.name} — Technical Blog`} href={abs('/rss.xml')} />
<link rel="sitemap" type="application/xml" href={abs('/sitemap-index.xml')} />
{verify.googleSiteVerification && <meta name="google-site-verification" content={verify.googleSiteVerification} />}
{verify.bingSiteVerification && <meta name="msvalidate.01" content={verify.bingSiteVerification} />}
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_US" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{type === 'article' && published && <meta property="article:published_time" content={published.toISOString()} />}
{type === 'article' && (modified ?? published) && <meta property="article:modified_time" content={(modified ?? published)!.toISOString()} />}
{type === 'article' && <meta property="article:author" content={personRef.url} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
{type === 'article' && tags.map(t => <meta property="article:tag" content={t} />)}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={imageAlt} />
<script type="application/ld+json" set:html={ld} />
<script is:inline>document.documentElement.classList.add('js')</script>
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;450;500;550;600;650;700;750;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
<div class="site-shell">
  <div class="header-bar"><header class="header container" id="top">
    <a class="brand" href={href('/')} aria-label="Essam Shaaban home"><span class="brand-mark">E<span>.</span></span><span class="brand-label">ESSAM<span class="brand-muted"> / SHAABAN</span></span></a>
    <nav class="desktop-nav" aria-label="Primary navigation">{links.map(([name,path]) => <a href={href(path)} aria-current={isCurrent(path) ? 'page' : undefined}>{name}</a>)}</nav>
    <a class="nav-cta" href={href('/#contact')}>Let's connect <span aria-hidden="true">→</span></a>
    <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu"><span></span><span></span><span></span></button>
  </header>
  <nav id="mobile-menu" class="mobile-nav container" aria-label="Mobile navigation" hidden>{links.map(([name,path]) => <a href={href(path)}>{name}</a>)}<a href={href('/#contact')}>Contact</a></nav></div>
  <main id="main" tabindex="-1"><slot /></main>
  <footer class="footer container"><div class="footer-top"><a class="brand" href={href('/')}><span class="brand-mark">E<span>.</span></span><span class="brand-label">ESSAM <span class="brand-muted">/ SHAABAN</span></span></a><nav class="footer-links" aria-label="Profiles">{site.links.linkedin && <a href={site.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}{site.links.mvp && <a href={site.links.mvp} target="_blank" rel="noopener">MVP profile</a>}{site.links.email && <a href={`mailto:${site.links.email}`}>Email</a>}</nav></div><div class="footer-bottom"><span>© {new Date().getFullYear()} Essam Shaaban. All rights reserved.</span><span>Built with Astro · Hosted on GitHub Pages</span><a href="#top">Back to top ↑</a></div></footer>
</div>
<script>
const button = document.querySelector<HTMLButtonElement>('.menu-toggle');
const nav = document.querySelector<HTMLElement>('#mobile-menu');
button?.addEventListener('click', () => { const open = button.getAttribute('aria-expanded') !== 'true'; button.setAttribute('aria-expanded', String(open)); button.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); if(nav) nav.hidden = !open; });
nav?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => { nav.hidden = true; button?.setAttribute('aria-expanded', 'false'); }));
const targets = document.querySelectorAll<HTMLElement>('.section-heading, .about-grid > *, .expertise-card, .project-card, .cert-featured, .credential-mini, .recognition-banner, .cert-actions, .blog-card, .center-action, .cert-group-title, .cert-card, .cert-disclaimer, .contact-inner, .cg-group-head, .cg-card');
if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
  const io = new IntersectionObserver(entries => entries.forEach(e => { if (e.isIntersecting) { const t = e.target as HTMLElement; t.classList.add('in'); io.unobserve(t); setTimeout(() => { t.style.transitionDelay = ''; }, 1200); } }), { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
  targets.forEach(el => { const sibs = el.parentElement ? Array.from(el.parentElement.children) : []; el.style.transitionDelay = `${Math.min(sibs.indexOf(el), 4) * 70}ms`; el.classList.add('reveal'); io.observe(el); });
}
</script>
</body></html>
